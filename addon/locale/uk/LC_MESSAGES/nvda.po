#: __init__.py:297
msgid "Translation API blocked due to rate limits. Please try again later."
msgstr "API перекладу заблоковано через обмеження частоти запитів. Будь ласка, спробуйте пізніше."

#: setting.py:172
msgid "Translation engine:"
msgstr "Рушій перекладу:"

#: long_translation_dialog.py:343
msgid "Translation failed."
msgstr "Збій перекладу."

#: __init__.py:303
msgid "Translation failed. Please check your network connection."
msgstr "Збій перекладу. Будь ласка, перевірте мережеве з'єднання."

#: __init__.py:300
#: long_translation_dialog.py:331
msgid "Translation failed: {error}"
msgstr "Збій перекладу: {error}"

#: __init__.py:230
msgid "Translation in progress, please wait."
msgstr "Триває переклад, будь ласка, зачекайте."

#: long_translation_dialog.py:323
msgid "Translation service is rate limited. Translation paused before chunk {current} of {total} to avoid replacing untranslated text with English text. Progress has been saved - run this translation again shortly to continue where it left off."
msgstr "Служба перекладу обмежила частоту запитів. Переклад призупинено перед фрагментом {current} з {total}, щоб уникнути заміни неперекладеного тексту англійським. Прогрес збережено — запустіть цей переклад знову незабаром, щоб продовжити з місця зупинки."

